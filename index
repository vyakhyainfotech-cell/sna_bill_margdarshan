                <div class="voucher-meta-row">
                    <div><strong>વાઉચર સંદર્ભ / ફાઈલ નં:</strong> ${voucher}</div>
                    <div><strong>તારીખ:</strong> ${bDate}</div>
                </div>

                <div class="sheet-section-title">૧. ઈ.ડી.પી. ડિટેલ્સ (૩૧૩૫ થી ૩૧૩૫)</div>
                <div class="sheet-edp-box">
                    <div>
                        <strong>સ્પર્શ પોર્ટલમાં EDP 3135 to 3135 માં નાખવાની કુલ રકમ:</strong>
                        <div style="font-size:9.5px; color:#475569;">(અંકે રૂપિયા: ${splitEdpWords})</div>
                    </div>
                    <div style="font-size: 14px; font-weight: 900; background: #f1f5f9; padding: 2px 8px; border-radius: 4px; border: 1px solid #cbd5e1;">
                        ₹ ${splitEdpTotal}
                    </div>
                </div>

                <div class="sheet-section-title">૨. હેડ વાઇઝ રકમની વિગત (${percentText} રકમ)</div>
                <table class="sheet-table">
                    <thead>
                        <tr>
                            <th style="width:28px; text-align:center;">ક્રમ</th>
                            <th>ગ્રાન્ટ હેડનું નામ / કમ્પોનન્ટ કોડ</th>
                            <th style="text-align:right; width:100px;">કુલ મૂળ રકમ (૧૦૦%)</th>
                            <th style="text-align:right; width:110px;">સ્પર્શમાં નાખવાની ${percentText} રકમ</th>
                        </tr>
                    </thead>
                    <tbody>${headRows}</tbody>
                </table>

                <div class="sheet-section-title">૩. બેનિફિશિયરીઝ (લાભાર્થી) વાઇઝ ચૂકવવાની રકમ અને હેડ વાઇઝ વિગત</div>
                <table class="sheet-table">
                    <thead>
                        <tr>
                            <th style="width:28px; text-align:center;">ક્રમ</th>
                            <th style="width:180px;">લાભાર્થીનું નામ</th>
                            <th style="text-align:right; width:100px;">મળવાપાત્ર કુલ ${percentText} રકમ</th>
                            <th>જે-તે હેડમાંથી લેવાની ${percentText} રકમની વિગત (લાઇન-બાય-લાઇન)</th>
                        </tr>
                    </thead>
                    <tbody>${beneRows}</tbody>
                </table>
            </div>
        `;
    }

    // Modal Control: Open and Render Preview
    function openPreviewModal(mode) {
        if (beneficiaries.length === 0) {
            alert('પહેલાં ઓછામાં ઓછો એક લાભાર્થી ઉમેરવો જરૂરી છે.');
            return;
        }

        let fullHtml = '';

        if (mode === '60') {
            document.getElementById('modalHeading').innerHTML = `<span>👁️</span> ૬૦% બિલની પૂર્વ તૈયારી વિગત`;
            fullHtml = generateSubSlipHtml(0.6, '૬૦%', '#059669');
        } else if (mode === '40') {
            document.getElementById('modalHeading').innerHTML = `<span>👁️</span> ૪૦% બિલની પૂર્વ તૈયારી વિગત`;
            fullHtml = generateSubSlipHtml(0.4, '૪૦%', '#0284c7');
        } else if (mode === 'both_a5') {
            document.getElementById('modalHeading').innerHTML = `<span>📄</span> ૧ જ પેજમાં બંને બિલ (ઉપર ૬૦% + નીચે ૪૦% A5 સાઇઝ)`;
            const slip60 = generateSubSlipHtml(0.6, '૬૦%', '#059669');
            const slip40 = generateSubSlipHtml(0.4, '૪૦%', '#0284c7');
            fullHtml = `
                ${slip60}
                <div class="cut-divider">
                    <span class="cut-label">✂️ અહીથી કાપીને બે અલગ A5 સ્લિપ બનાવી શકો છો (૬૦% અને ૪૦%)</span>
                </div>
                ${slip40}
            `;
        }

        document.getElementById('printableContent').innerHTML = fullHtml;
        document.getElementById('previewModal').style.display = 'block';
    }

    function closePreviewModal() {
        document.getElementById('previewModal').style.display = 'none';
    }

    window.onclick = function(event) {
        const modal = document.getElementById('previewModal');
        if (event.target === modal) {
            closePreviewModal();
        }
    };

    // Initialize datalist and form on page load
    populateDatalist();
    initHeadRow();
    renderBeneficiariesTable();
</script>

</body>
</html>
