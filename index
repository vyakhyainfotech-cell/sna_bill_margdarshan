                        <span>${h.head}</span>
                        <strong style="margin-left: 6px;">₹${h.amount.toFixed(2)}</strong>
                    </div>`;
            });
            headsHtml += '</div>';

            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td style="text-align: center; font-weight:700; color:#64748b;">${index + 1}</td>
                <td><strong style="color:#0f172a; font-size:13px;">${b.name}</strong></td>
                <td>${headsHtml}</td>
                <td style="text-align: right; font-weight:700;">₹${b.total.toFixed(2)}</td>
                <td style="text-align: right; color:#059669; font-weight:700;">₹${b60}</td>
                <td style="text-align: right; color:#0284c7; font-weight:700;">₹${b40}</td>
