    function resetForm() {
        document.getElementById('beneficiaryName').value = '';
        initHeadRow();
        document.getElementById('beneficiaryName').focus();
    }

    // Save beneficiary
    function saveBeneficiary() {
        const nameInput = document.getElementById('beneficiaryName');
        const name = nameInput.value.trim();

        if (!name) {
            alert('કૃપા કરીને લાભાર્થીનું નામ લખો.');
            nameInput.focus();
            return;
        }

        const headRows = document.querySelectorAll('#headsContainer .head-row');
        const heads = [];
        let hasError = false;

        headRows.forEach(row => {
            const headName = row.querySelector('.head-input').value.trim();
            const amountVal = parseFloat(row.querySelector('.head-amount').value);

            if (!headName) {
                alert('કૃપા કરીને ગ્રાન્ટ હેડ દાખલ કરો અથવા સિલેક્ટ કરો.');
                hasError = true;
                return;
            }
            if (isNaN(amountVal) || amountVal <= 0) {
                alert('કૃપા કરીને હેડ માટે માન્ય રકમ દાખલ કરો.');
                hasError = true;
                return;
            }

            heads.push({
                head: headName,
                amount: amountVal
            });
        });

        if (hasError) return;

        const totalAmount = heads.reduce((sum, h) => sum + h.amount, 0);

        beneficiaries.push({
            id: Date.now(),
            name: name,
            heads: heads,
            total: totalAmount
        });

        renderBeneficiariesTable();
        resetForm();
    }

    function deleteBeneficiary(index) {
        if (confirm('શું તમે આ લાભાર્થીની વિગત રદ કરવા માંગો છો?')) {
            beneficiaries.splice(index, 1);
            renderBeneficiariesTable();
        }
    }

    function clearAllData() {
        if (beneficiaries.length === 0) return;
        if (confirm('શું તમે તમામ લાભાર્થીઓની યાદી સાફ કરવા માંગો છો?')) {
            beneficiaries = [];
            renderBeneficiariesTable();
            resetForm();
        }
    }

    // Render Preview Table
    function renderBeneficiariesTable() {
        const tbody = document.getElementById('beneficiaryTableBody');
        const totalsBar = document.getElementById('totalsBar');

        if (beneficiaries.length === 0) {
            tbody.innerHTML = `
                <tr>
