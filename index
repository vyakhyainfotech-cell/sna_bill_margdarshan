                        હજુ સુધી કોઈ લાભાર્થી ઉમેરેલ નથી. કૃપા કરીને ઉપરના ફોર્મમાંથી લાભાર્થી ઉમેરો.
                    </td>
                </tr>
            `;
            totalsBar.style.display = 'none';
            return;
        }

        tbody.innerHTML = '';
        let grandTotal = 0;
        const uniqueHeads = new Set();

        beneficiaries.forEach((b, index) => {
            grandTotal += b.total;
            const b60 = (b.total * 0.6).toFixed(2);
